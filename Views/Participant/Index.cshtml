@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Participant Home";
}

<div class="container mt-4">

    <h2>Upcoming Events</h2>
    <p>Browse available events and find one to enter.</p>

    @if (Model == null || Model.Count == 0)
    {
        <p>No upcoming events are currently available.</p>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p><strong>Type:</strong> @item.EventType</p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Status:</strong>
                                @item.Status
                            </p>

                            <p>@item.Description</p>

                            <a asp-controller="Participant"
                               asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>