@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">

    <h2>@Model.EventName</h2>

    <div class="card mt-3">
        <div class="card-body">

            <p>
                <strong>Event Type:</strong>
                @Model.EventType
            </p>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <hr />

            <h5>Description</h5>
            <p>@Model.Description</p>

            <a asp-controller="Participant"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Events
            </a>

        </div>
    </div>

</div>
