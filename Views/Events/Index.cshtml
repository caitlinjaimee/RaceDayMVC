@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Events";
}

<h2>Upcoming Events</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create Event
</a>

@if (Model == null || !Model.Any())
{
    <p>No events are currently available.</p>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.EventName</h5>

                        <p>@item.EventType</p>
                        <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                        <p><strong>Location:</strong> @item.Location</p>
                        <p><strong>Status:</strong> @item.Status</p>
                        <p>@item.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
}